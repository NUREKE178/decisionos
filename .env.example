# --- Frontend (safe to be public; baked into src/lib/env.js, not read at runtime) ---
# Project Settings > API in your Supabase dashboard.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# --- CLI / deploy only (never shipped to the browser) ---
# Project Settings > API > Project API keys > service_role (secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Project Settings > General > Reference ID
SUPABASE_PROJECT_REF=xxxxxxxxxxxx
# https://supabase.com/dashboard/account/tokens -- used by `supabase` CLI to
# link/push migrations and deploy Edge Functions.
SUPABASE_ACCESS_TOKEN=sbp_...

# --- Edge Function secret (set via `supabase secrets set`, NOT in this file) ---
# Deferred: AI insights are stubbed until this is configured. See
# supabase/functions/generate-insights/index.ts.
# AI_API_KEY=sk-ant-...
